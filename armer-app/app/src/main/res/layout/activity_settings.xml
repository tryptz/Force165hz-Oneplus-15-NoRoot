<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- header: back + title + actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="@dimen/screen_pad">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:contentDescription="@string/back_desc" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_log_share"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="9dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_share"
            android:tint="@color/text_primary"
            android:contentDescription="@string/log_share" />

        <ImageView
            android:id="@+id/btn_log_refresh"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_refresh"
            android:tint="@color/text_primary"
            android:contentDescription="@string/log_refresh" />
    </LinearLayout>

    <!-- what the two tags mean -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingTop="4dp"
        android:text="@string/log_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- usage access: what lets the watchdog order its votes around the app
         on screen. Status and button are refreshed in onResume, so coming back
         from Settings shows the new state. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fg_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fg_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/fg_off"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_fg_grant"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/fg_grant"
            android:textColor="@color/on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- console -->
    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_code"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:fontFamily="monospace"
            android:textSize="10.5sp"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:text="@string/log_loading" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginBottom="@dimen/screen_pad"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_log_clear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_tonal"
            android:text="@string/log_clear"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_log_autorefresh"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/log_auto_on"
            android:textColor="@color/on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
