<?xml version="1.0" encoding="utf-8"?>
<!--
    Material You palette (API 31+). Overrides the static light brand/surface
    tokens with the wallpaper-derived system colors; values-night-v31 carries
    the dark-mode counterparts. Tonal numbering: light _N = tone(100 - N/10).
-->
<resources>
    <!-- surfaces -->
    <color name="bg">@android:color/system_neutral1_50</color>
    <color name="surface">@android:color/system_neutral1_0</color>
    <color name="surface_variant">@android:color/system_neutral2_100</color>
    <color name="bar">@android:color/system_neutral1_0</color>

    <!-- hero card gradient -->
    <color name="hero_start">@android:color/system_neutral1_0</color>
    <color name="hero_end">@android:color/system_accent1_50</color>

    <!-- text -->
    <color name="text_primary">@android:color/system_neutral1_900</color>
    <color name="text_secondary">@android:color/system_neutral2_500</color>
    <color name="text_disabled">@android:color/system_neutral2_300</color>

    <!-- brand -->
    <color name="accent">@android:color/system_accent1_600</color>
    <color name="on_accent">@android:color/system_accent1_0</color>
    <color name="accent_container">@android:color/system_accent1_100</color>
    <color name="on_accent_container">@android:color/system_accent1_900</color>
    <color name="accent_outline">@android:color/system_accent1_100</color>

    <!-- list rows / controls -->
    <color name="row_armed">@android:color/system_accent1_50</color>
    <color name="switch_track_off">@android:color/system_neutral2_300</color>
    <color name="switch_thumb_off">@android:color/system_neutral2_400</color>

    <!-- snackbar -->
    <color name="snack_bg">@android:color/system_neutral1_900</color>
    <color name="snack_text">@android:color/system_neutral1_50</color>
</resources>
