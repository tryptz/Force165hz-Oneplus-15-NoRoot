<?xml version="1.0" encoding="utf-8"?>
<!-- Fades list content out behind the floating action bar. angle 90 = bottom to top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="@color/bg"
        android:endColor="@color/bg_fade" />
</shape>
