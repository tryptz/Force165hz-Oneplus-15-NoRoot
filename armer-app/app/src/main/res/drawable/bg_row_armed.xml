<?xml version="1.0" encoding="utf-8"?>
<!-- Armed row: accent-tinted fill so armed apps read at a glance. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/row_armed" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/accent_outline" />
        </shape>
    </item>
</ripple>
