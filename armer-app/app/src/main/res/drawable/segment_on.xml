<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected segment, as a plain shape rather than a state in a selector:
  RemoteViews cannot drive a selector, because the method that would set the
  state is not guaranteed remotable. setBackgroundResource is, so the widget
  swaps the whole drawable instead. Same fill as segment_states' selected item.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/accent" />
    <corners android:radius="100dp" />
</shape>
